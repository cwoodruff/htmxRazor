<div class="theme-preview">
    <h3 class="theme-preview__heading">Live Preview</h3>

    <!-- Buttons -->
    <div class="theme-preview__section">
        <h4>Buttons</h4>
        <div class="theme-preview__row">
            <rhx-button rhx-variant="brand">Brand</rhx-button>
            <rhx-button rhx-variant="brand" rhx-appearance="outlined">Outlined</rhx-button>
            <rhx-button rhx-variant="brand" rhx-appearance="plain">Plain</rhx-button>
        </div>
        <div class="theme-preview__row">
            <rhx-button rhx-variant="neutral">Neutral</rhx-button>
            <rhx-button rhx-variant="success">Success</rhx-button>
            <rhx-button rhx-variant="warning">Warning</rhx-button>
            <rhx-button rhx-variant="danger">Danger</rhx-button>
        </div>
        <div class="theme-preview__row">
            <rhx-button rhx-variant="brand" rhx-size="small">Small</rhx-button>
            <rhx-button rhx-variant="brand">Medium</rhx-button>
            <rhx-button rhx-variant="brand" rhx-size="large">Large</rhx-button>
        </div>
    </div>

    <!-- Badges & Tags -->
    <div class="theme-preview__section">
        <h4>Badges</h4>
        <div class="theme-preview__row">
            <rhx-badge rhx-variant="neutral">Neutral</rhx-badge>
            <rhx-badge rhx-variant="brand">Brand</rhx-badge>
            <rhx-badge rhx-variant="success">Success</rhx-badge>
            <rhx-badge rhx-variant="warning">Warning</rhx-badge>
            <rhx-badge rhx-variant="danger">Danger</rhx-badge>
        </div>
    </div>

    <!-- Callouts -->
    <div class="theme-preview__section">
        <h4>Callouts</h4>
        <rhx-callout rhx-variant="brand">This is a brand callout message.</rhx-callout>
        <rhx-callout rhx-variant="success">Operation completed successfully.</rhx-callout>
        <rhx-callout rhx-variant="danger">An error occurred during processing.</rhx-callout>
    </div>

    <!-- Form Controls -->
    <div class="theme-preview__section">
        <h4>Form Controls</h4>
        <div class="theme-preview__form-row">
            <rhx-input rhx-type="text" rhx-placeholder="Text input" rhx-label="Name" name="preview-name" />
        </div>
        <div class="theme-preview__form-row">
            <rhx-checkbox rhx-label="Accept terms" name="preview-terms" />
        </div>
    </div>

    <!-- Card -->
    <div class="theme-preview__section">
        <h4>Card</h4>
        <rhx-card>
            <rhx-card-header>Card Title</rhx-card-header>
            This is a sample card to preview surface, border, and shadow tokens.
            <rhx-card-footer>
                <rhx-button rhx-variant="brand" rhx-size="small">Action</rhx-button>
            </rhx-card-footer>
        </rhx-card>
    </div>

    <!-- Progress -->
    <div class="theme-preview__section">
        <h4>Progress</h4>
        <rhx-progress-bar rhx-value="65" rhx-label="65% complete" />
    </div>

    <!-- Tooltip -->
    <div class="theme-preview__section">
        <h4>Tooltip</h4>
        <rhx-tooltip rhx-content="This is a tooltip" rhx-placement="top">
            <rhx-button rhx-variant="neutral" rhx-appearance="outlined">Hover me</rhx-button>
        </rhx-tooltip>
    </div>
</div>
