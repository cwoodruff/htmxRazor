<body class="docs-layout @(showSidebar ? "" : "docs-layout--no-sidebar")">

    <header class="docs-topbar rhx-surface">
        <div class="docs-topbar__start">
            <button class="docs-topbar__menu-btn" onclick="document.getElementById('mobile-nav').showModal ? document.getElementById('mobile-nav').showModal() : null" aria-label="Open navigation">&#9776;</button>
            <a href="/" class="docs-topbar__logo">htmxRazor</a>
        </div>
        <div class="docs-topbar__end">
            <a href="/Roadmap" class="rhx-button rhx-button--neutral rhx-button--outlined rhx-button--small">
                <span class="rhx-button__label">Roadmap</span>
            </a>
            <a href="https://github.com/cwoodruff/htmxRazor" class="rhx-button rhx-button--neutral rhx-button--outlined rhx-button--small" target="_blank" rel="noopener noreferrer">
                <span class="rhx-button__label">GitHub</span>
            </a>
            <rhx-theme-toggle aria-label="Toggle dark mode" />
        </div>
    </header>

    @if (showSidebar)
    {
        <aside class="docs-sidebar">
            @await Html.PartialAsync("_SidebarNav")
        </aside>
    }

    <main class="docs-main">
        @if (ViewData["Breadcrumbs"] is IList<BreadcrumbItem> crumbs)
        {
            <rhx-breadcrumb rhx-items="@crumbs" />
        }
        @RenderBody()
    </main>

    <rhx-drawer id="mobile-nav" rhx-label="Navigation" rhx-placement="start">
        @await Html.PartialAsync("_SidebarNav")
    </rhx-drawer>

    @await Html.PartialAsync("_Footer")

    <rhx-toast-container rhx-position="top-end" />

    @Html.AntiForgeryToken()
    <script>
        document.addEventListener('htmx:configRequest', function(e) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) e.detail.headers['RequestVerificationToken'] = token.value;
        });
    </script>
    <script src="/_rhx/js/components/rhx-copy-button.js" defer></script>
    <script src="/_rhx/js/components/rhx-password-toggle.js" defer></script>
    <script src="/_rhx/js/components/rhx-textarea-autosize.js" defer></script>
    <script src="/_rhx/js/components/rhx-dialog.js" defer></script>
    <script src="/_rhx/js/components/rhx-zoomable-frame.js" defer></script>
    <script src="/_rhx/js/rhx-scroll-buttons.js" defer></script>
    <script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js" defer></script>
    <script src="https://unpkg.com/htmx-ext-response-targets@2.0.2/response-targets.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
