@page
@model RadialSelectModel
@{
    Layout = "_ComponentPage";
    ViewData["Title"] = "Radial Select";
    ViewData["ComponentName"] = "Radial Select";
    ViewData["ComponentTag"] = "rhx-radial-select";
    ViewData["ComponentDescription"] = "A cascading category → item picker built from two native <select>s. Changing the category loads the item options via htmx — no JavaScript.";
}

<section class="docs-component-section">
    <h2>Examples</h2>

    <!-- Basic -->
    <div class="docs-example">
        <h3>Cascading category → item</h3>
        <rhx-tab-group>
            <rhx-tab rhx-panel="basic-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="basic-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="basic-preview" rhx-active="true">
                <div class="docs-preview docs-preview--vertical" style="align-items: flex-start;">
                    <rhx-radial-select name="FoodItem" rhx-category-name="cat"
                                       rhx-default-category="fruit"
                                       hx-get="/Docs/Components/RadialSelect?handler=Items"
                                       rhx-placeholder="Choose an item…" aria-label="Food">
                        <rhx-radial-option rhx-value="fruit" rhx-label="Fruit" />
                        <rhx-radial-option rhx-value="veg" rhx-label="Veggies" />
                        <rhx-radial-option rhx-value="meat" rhx-label="Meat" />
                        <rhx-radial-option rhx-value="drink" rhx-label="Drinks" />
                    </rhx-radial-select>
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="basic-code">
                <div class="docs-code">
                    <pre><code>@Model.BasicCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>
</section>

<!-- Properties -->
<section class="docs-component-section">
    <h2><code>&lt;rhx-radial-select&gt;</code> Properties</h2>
</section>
@await Html.PartialAsync("_PropertyTable", Model.Properties)

<section class="docs-component-section">
    <h2><code>&lt;rhx-radial-option&gt;</code> Properties</h2>
</section>
@await Html.PartialAsync("_PropertyTable", Model.OptionProperties)

<!-- Accessibility -->
<section class="docs-component-section">
    <h2>Accessibility</h2>
    <ul class="docs-a11y-list">
        <li>Built from two native <code>&lt;select&gt;</code> elements (category + item), so keyboard support, the option list, and accessibility come from the browser — no JavaScript.</li>
        <li>Changing the category <code>&lt;select&gt;</code> fires the cascade (<code>hx-trigger="change, load"</code>); htmx sends the chosen category and swaps the item <code>&lt;select&gt;</code>'s <code>&lt;option&gt;</code>s.</li>
        <li>The item select carries the bound field value; the category select carries the category value (<code>rhx-category-name</code>).</li>
        <li>The SVG pie and its pointer/keyboard interaction are replaced by the native selects (accepted change).</li>
    </ul>
</section>
