@page
@model AnimatedImageModel
@{
    Layout = "_ComponentPage";
    ViewData["Title"] = "Animated Image";
    ViewData["ComponentName"] = "Animated Image";
    ViewData["ComponentTag"] = "rhx-animated-image";
    ViewData["ComponentDescription"] = "GIF/APNG display. With a poster it pauses (showing the still) and plays on hover/focus — pure CSS, no JavaScript.";
}

<section class="docs-component-section">
    <h2>Examples</h2>

    <!-- Plays continuously -->
    <div class="docs-example">
        <h3>Plays continuously</h3>
        <p>Without a poster the animation simply plays.</p>
        <rhx-tab-group>
            <rhx-tab rhx-panel="plays-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="plays-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="plays-preview" rhx-active="true">
                <div class="docs-preview">
                    <rhx-animated-image rhx-src="https://media.giphy.com/media/xT9IgzoKnwFNmISR8I/giphy.gif" rhx-alt="Animated loading" />
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="plays-code">
                <div class="docs-code">
                    <pre><code>@Model.PlaysCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>

    <!-- Hover to play -->
    <div class="docs-example">
        <h3>Hover to play (with poster)</h3>
        <p>Add a <code>rhx-poster</code> still and the control stays paused until you hover or focus it — no JavaScript.</p>
        <rhx-tab-group>
            <rhx-tab rhx-panel="hover-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="hover-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="hover-preview" rhx-active="true">
                <div class="docs-preview">
                    <rhx-animated-image rhx-src="https://media.giphy.com/media/xT9IgzoKnwFNmISR8I/giphy.gif" rhx-poster="https://media.giphy.com/media/xT9IgzoKnwFNmISR8I/giphy_s.gif" rhx-alt="Hover to play" />
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="hover-code">
                <div class="docs-code">
                    <pre><code>@Model.HoverCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>
</section>

<!-- Properties -->
@await Html.PartialAsync("_PropertyTable", Model.Properties)

<!-- Accessibility -->
<section class="docs-component-section">
    <h2>Accessibility</h2>
    <ul class="docs-a11y-list">
        <li>The image receives <code>alt</code> text from <code>rhx-alt</code> for screen-reader users.</li>
        <li>With a poster the control is keyboard-focusable (<code>tabindex="0"</code>, <code>role="img"</code>) so it also plays on focus, not only hover.</li>
        <li>Honors <code>prefers-reduced-motion</code>: the poster stays put and the cross-fade is disabled.</li>
    </ul>
</section>
