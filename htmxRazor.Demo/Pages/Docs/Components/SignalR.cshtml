@page
@model SignalRModel
@{
    Layout = "_ComponentPage";
    ViewData["Title"] = "SignalR";
    ViewData["ComponentName"] = "SignalR Connector";
    ViewData["ComponentTag"] = "rhx-signalr";
    ViewData["ComponentDescription"] = "Declarative SignalR hub connection that swaps received HTML fragments into the DOM in real time.";
}

<section class="docs-component-section">
    <h2>Examples</h2>

    <rhx-callout rhx-variant="neutral">
        The SignalR Connector requires the
        <code>@@microsoft/signalr</code> client library loaded before <code>rhx-signalr.js</code>.
        This demo site includes it globally. In your own project, add
        <code>&lt;script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"&gt;&lt;/script&gt;</code>
        to your layout.
    </rhx-callout>

    <!-- Server Clock -->
    <div class="docs-example">
        <h3>Server Clock</h3>
        <p>A background service pushes the server time every 2 seconds via <code>IHubContext&lt;DemoHub&gt;</code>. The component replaces its content on each message.</p>
        <rhx-tab-group>
            <rhx-tab rhx-panel="clock-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="clock-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="clock-preview" rhx-active="true">
                <div class="docs-preview" style="text-align: center; padding: var(--rhx-space-xl);">
                    <rhx-signalr hub-url="/demoHub" rhx-method="ServerClock"
                                 rhx-connection-state="true">
                        <rhx-spinner rhx-size="small" />
                    </rhx-signalr>
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="clock-code">
                <div class="docs-code">
                    <pre><code>@Model.ClockCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>

    <!-- Chat Messages -->
    <div class="docs-example">
        <h3>Chat Messages</h3>
        <p>Type a message and click Send. The hub broadcasts to all connected clients and the <code>beforeend</code> swap appends each message.</p>
        <rhx-tab-group>
            <rhx-tab rhx-panel="chat-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="chat-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="chat-preview" rhx-active="true">
                <div class="docs-preview">
                    <rhx-signalr id="chat-connector" hub-url="/demoHub" rhx-method="ReceiveMessage"
                                 rhx-swap="beforeend" rhx-target="#chat-messages"
                                 rhx-connection-state="true">
                    </rhx-signalr>

                    <div id="chat-messages" style="max-height: 12rem; overflow-y: auto; margin-bottom: var(--rhx-space-md); border: var(--rhx-border-width) solid var(--rhx-color-border-muted); border-radius: var(--rhx-radius-md); padding: var(--rhx-space-sm);">
                        <p style="color: var(--rhx-color-text-muted); font-size: var(--rhx-font-size-sm);">Messages will appear here...</p>
                    </div>

                    <div style="display: flex; gap: var(--rhx-space-sm);">
                        <input id="chat-user" type="text" placeholder="Name" value="Demo User"
                               style="flex: 0 0 8rem; padding: var(--rhx-space-xs) var(--rhx-space-sm); border: var(--rhx-border-width) solid var(--rhx-color-border); border-radius: var(--rhx-radius-md); font-size: var(--rhx-font-size-sm);" />
                        <input id="chat-message" type="text" placeholder="Type a message..."
                               style="flex: 1; padding: var(--rhx-space-xs) var(--rhx-space-sm); border: var(--rhx-border-width) solid var(--rhx-color-border); border-radius: var(--rhx-radius-md); font-size: var(--rhx-font-size-sm);" />
                        <rhx-button rhx-variant="brand" rhx-size="small" id="chat-send-btn">Send</rhx-button>
                    </div>
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="chat-code">
                <div class="docs-code">
                    <pre><code>@Model.ChatCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>

    <!-- Hub Implementation -->
    <div class="docs-example">
        <h3>Hub Implementation</h3>
        <p>Define a standard SignalR hub. The <code>JoinGroup</code> method is required if you use <code>rhx-groups</code>.</p>
        <div class="docs-code">
            <pre><code>@Model.HubCode</code></pre>
        </div>
    </div>

    <!-- Server-Side Extensions -->
    <div class="docs-example">
        <h3>Server-Side Extensions</h3>
        <p>Use <code>HtmxSignalRExtensions</code> to send HTML fragments from controllers, background services, or anywhere you have <code>IHubContext</code>.</p>
        <div class="docs-code">
            <pre><code>@Model.ExtensionsCode</code></pre>
        </div>
    </div>

    <!-- Setup -->
    <div class="docs-example">
        <h3>Setup</h3>
        <div class="docs-code">
            <pre><code>@Model.SetupCode</code></pre>
        </div>
    </div>
</section>

@await Html.PartialAsync("_PropertyTable", Model.Properties)

<section class="docs-component-section">
    <h2>Accessibility</h2>
    <ul class="docs-a11y-list">
        <li>Container has <code>aria-live="polite"</code> so screen readers announce new content as it arrives.</li>
        <li>Connection state indicator uses color tokens with sufficient contrast (green/red/yellow).</li>
        <li>Reduced-motion users see a static indicator instead of the pulse animation.</li>
        <li>Swapped content is processed by htmx so any <code>aria-*</code> attributes in the HTML fragments are preserved.</li>
    </ul>
</section>

<!-- Chat send button wiring -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var sendBtn = document.getElementById("chat-send-btn");
        var messageInput = document.getElementById("chat-message");
        if (!sendBtn || !messageInput) return;

        function sendMessage() {
            var connector = document.getElementById("chat-connector");
            if (!connector || !connector._rhxSignalRConnection) return;

            var user = document.getElementById("chat-user").value || "Anonymous";
            var message = messageInput.value;
            if (!message) return;

            connector._rhxSignalRConnection.invoke("SendMessage", user, message).catch(function (err) {
                console.error("[demo] SendMessage failed:", err);
            });
            messageInput.value = "";
        }

        sendBtn.addEventListener("click", sendMessage);
        messageInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") sendMessage();
        });
    });
</script>
