@page
@model SignalRModel
@{
    Layout = "_ComponentPage";
    ViewData["Title"] = "SignalR";
    ViewData["ComponentName"] = "SSE Connector";
    ViewData["ComponentTag"] = "rhx-signalr";
    ViewData["ComponentDescription"] = "Declarative server→client push that swaps received HTML fragments into the DOM in real time, via the htmx SSE extension — no custom JavaScript.";
}

<section class="docs-component-section">
    <h2>Examples</h2>

    <rhx-callout rhx-variant="neutral">
        The connector uses the <strong>htmx SSE extension</strong> (<code>sse.js</code>) — already
        included on this site. It emits <code>hx-ext="sse"</code> + <code>sse-connect</code> +
        <code>sse-swap</code>; the browser's native <code>EventSource</code> does the rest. No
        SignalR client library and no custom JavaScript.
    </rhx-callout>

    <!-- Server Clock -->
    <div class="docs-example">
        <h3>Server Clock</h3>
        <p>A streaming endpoint pushes the server time every second as a named <code>ServerClock</code> SSE event. The component replaces its content on each message.</p>
        <rhx-tab-group>
            <rhx-tab rhx-panel="clock-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="clock-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="clock-preview" rhx-active="true">
                <div class="docs-preview" style="text-align: center; padding: var(--rhx-space-xl);">
                    <rhx-signalr hub-url="/demo-sse/clock" rhx-method="ServerClock">
                        <rhx-spinner rhx-size="small" />
                    </rhx-signalr>
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="clock-code">
                <div class="docs-code">
                    <pre><code>@Model.ClockCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>

    <!-- Chat Messages -->
    <div class="docs-example">
        <h3>Chat Messages</h3>
        <p>Sending posts the message with htmx; the server broadcasts it as a <code>ReceiveMessage</code> SSE event to every connected client, and the <code>beforeend</code> swap appends it.</p>
        <rhx-tab-group>
            <rhx-tab rhx-panel="chat-preview" rhx-active="true">Preview</rhx-tab>
            <rhx-tab rhx-panel="chat-code">Code</rhx-tab>
            <rhx-tab-panel rhx-name="chat-preview" rhx-active="true">
                <div class="docs-preview">
                    <rhx-signalr id="chat-connector" hub-url="/demo-sse/chat" rhx-method="ReceiveMessage"
                                 rhx-swap="beforeend" rhx-target="#chat-messages">
                    </rhx-signalr>

                    <div id="chat-messages" style="max-height: 12rem; overflow-y: auto; margin-bottom: var(--rhx-space-md); border: var(--rhx-border-width) solid var(--rhx-color-border-muted); border-radius: var(--rhx-radius-md); padding: var(--rhx-space-sm);">
                        <p style="color: var(--rhx-color-text-muted); font-size: var(--rhx-font-size-sm);">Messages will appear here...</p>
                    </div>

                    <form hx-post="/demo-sse/chat-send" hx-swap="none"
                          hx-on::after-request="this.querySelector('[name=message]').value=''"
                          style="display: flex; gap: var(--rhx-space-sm);">
                        <input name="user" type="text" placeholder="Name" value="Demo User"
                               style="flex: 0 0 8rem; padding: var(--rhx-space-xs) var(--rhx-space-sm); border: var(--rhx-border-width) solid var(--rhx-color-border); border-radius: var(--rhx-radius-md); font-size: var(--rhx-font-size-sm);" />
                        <input name="message" id="chat-message" type="text" placeholder="Type a message..."
                               style="flex: 1; padding: var(--rhx-space-xs) var(--rhx-space-sm); border: var(--rhx-border-width) solid var(--rhx-color-border); border-radius: var(--rhx-radius-md); font-size: var(--rhx-font-size-sm);" />
                        <rhx-button type="submit" rhx-variant="brand" rhx-size="small" id="chat-send-btn">Send</rhx-button>
                    </form>
                </div>
            </rhx-tab-panel>
            <rhx-tab-panel rhx-name="chat-code">
                <div class="docs-code">
                    <pre><code>@Model.ChatCode</code></pre>
                </div>
            </rhx-tab-panel>
        </rhx-tab-group>
    </div>

    <!-- Endpoint Implementation -->
    <div class="docs-example">
        <h3>SSE Endpoint</h3>
        <p>Stream named events from a minimal-API endpoint with .NET's native <code>TypedResults.ServerSentEvents</code>.</p>
        <div class="docs-code">
            <pre><code>@Model.HubCode</code></pre>
        </div>
    </div>

    <!-- Setup -->
    <div class="docs-example">
        <h3>Setup</h3>
        <div class="docs-code">
            <pre><code>@Model.SetupCode</code></pre>
        </div>
    </div>
</section>

@await Html.PartialAsync("_PropertyTable", Model.Properties)

<section class="docs-component-section">
    <h2>Accessibility</h2>
    <ul class="docs-a11y-list">
        <li>Container has <code>aria-live="polite"</code> so screen readers announce new content as it arrives.</li>
        <li>Swapped content is processed by htmx, so any <code>aria-*</code> attributes in the HTML fragments are preserved.</li>
        <li>Server-Sent Events reconnect automatically (native <code>EventSource</code>) with no custom code.</li>
    </ul>
</section>
