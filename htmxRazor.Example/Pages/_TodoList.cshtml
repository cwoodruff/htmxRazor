@model List<htmxRazor.Example.Models.TodoItem>

@if (Model.Count == 0)
{
    <div class="todo-empty">
        <div class="todo-empty__icon">
            <rhx-icon rhx-name="check" rhx-size="large"></rhx-icon>
        </div>
        <p style="font-size: var(--rhx-font-size-lg); font-weight: var(--rhx-font-weight-medium);">No tasks here</p>
        <p>Add a new task to get started.</p>
    </div>
}
else
{
    <div class="todo-list">
        @foreach (var todo in Model)
        {
            <div class="todo-item @(todo.IsCompleted ? "todo-item--completed" : "")" id="todo-@todo.Id">
                <rhx-checkbox rhx-checked="@todo.IsCompleted"
                              rhx-optimistic="true"
                              hx-post="/?handler=Toggle&id=@todo.Id"
                              hx-target="#todo-list"
                              hx-include="[name='filter'],[name='sort']"
                              aria-label="@(todo.IsCompleted ? "Mark incomplete" : "Mark complete")">
                </rhx-checkbox>

                <div class="todo-item__content">
                    <p class="todo-item__title">@todo.Title</p>
                    <div class="todo-item__meta">
                        @{
                            var (variant, label) = todo.Priority switch
                            {
                                htmxRazor.Example.Models.TodoPriority.High => ("danger", "High"),
                                htmxRazor.Example.Models.TodoPriority.Low => ("neutral", "Low"),
                                _ => ("warning", "Medium")
                            };
                        }
                        <rhx-badge rhx-variant="@variant" rhx-pill="true">@label</rhx-badge>

                        @{ var category = htmxRazor.Example.Models.TodoCategory.Find(todo.Category); }
                        @if (category is not null)
                        {
                            <rhx-tag-item rhx-variant="@category.Color" rhx-size="small">
                                <rhx-icon rhx-name="@category.Icon" rhx-size="small"></rhx-icon>
                                @category.Name@(string.IsNullOrEmpty(todo.CategoryItem) ? "" : $" · {todo.CategoryItem}")
                            </rhx-tag-item>
                        }

                        @if (todo.IsCompleted && todo.CompletedAt.HasValue)
                        {
                            <rhx-tag-item rhx-variant="success" rhx-size="small">
                                <rhx-icon rhx-name="check" rhx-size="small"></rhx-icon>
                                Done @todo.CompletedAt.Value.ToString("MMM d")
                            </rhx-tag-item>
                        }
                        else if (todo.IsOverdue)
                        {
                            <rhx-badge rhx-variant="danger" rhx-pill="true">
                                Overdue @todo.DueAt!.Value.ToString(todo.DueTime is null ? "MMM d" : "MMM d, h:mm tt")
                            </rhx-badge>
                        }
                        else if (todo.DueAt is { } due)
                        {
                            <span>Due @due.ToString(todo.DueTime is null ? "MMM d" : "MMM d, h:mm tt")</span>
                        }
                        else
                        {
                            <span>Created @todo.CreatedAt.ToString("MMM d")</span>
                        }

                        @if (todo.ReminderAt is { } remind)
                        {
                            <span class="todo-item__reminder" title="Reminder">
                                <rhx-icon rhx-name="clock" rhx-size="small"></rhx-icon>
                                @remind.ToString("MMM d, h:mm tt")
                            </span>
                        }
                    </div>
                </div>

                <div class="todo-item__actions">
                    <rhx-tooltip rhx-content="Edit task" rhx-placement="top">
                        <rhx-button rhx-appearance="plain"
                                    rhx-size="small"
                                    aria-label="Edit task"
                                    hx-get="/?handler=EditForm&id=@todo.Id"
                                    hx-target="#edit-form-body"
                                    hx-swap="innerHTML">
                            <rhx-icon rhx-name="edit" rhx-size="small"></rhx-icon>
                        </rhx-button>
                    </rhx-tooltip>

                    <rhx-tooltip rhx-content="Delete task" rhx-placement="top">
                        <rhx-button rhx-variant="danger"
                                    rhx-appearance="plain"
                                    rhx-size="small"
                                    aria-label="Delete task"
                                    hx-delete="/?handler=Delete&id=@todo.Id"
                                    hx-target="#todo-list"
                                    hx-include="[name='filter'],[name='sort']"
                                    hx-confirm="Delete &quot;@todo.Title&quot;?">
                            <rhx-icon rhx-name="trash" rhx-size="small"></rhx-icon>
                        </rhx-button>
                    </rhx-tooltip>
                </div>
            </div>
        }
    </div>
}
