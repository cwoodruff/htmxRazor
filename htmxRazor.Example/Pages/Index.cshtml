@page
@model IndexModel
@{
    ViewData["Title"] = "My Tasks";
}

<!-- Stats -->
<div id="stats-section" hx-get="/?handler=Stats" hx-trigger="todoChanged from:body" hx-swap="innerHTML">
    @await Html.PartialAsync("_Stats", Model)
</div>

<!-- Progress -->
<div id="progress-section" hx-get="/?handler=Progress" hx-trigger="todoChanged from:body" hx-swap="innerHTML">
    @await Html.PartialAsync("_Progress", Model)
</div>

<!-- Toolbar: Search + Add button -->
<div class="toolbar">
    <div class="toolbar__search">
        <rhx-input rhx-label="Search tasks"
                   rhx-placeholder="Type to filter..."
                   rhx-with-clear="true"
                   rhx-size="small"
                   name="search"
                   hx-get="/?handler=TodoList"
                   hx-trigger="input changed delay:300ms, search"
                   hx-target="#todo-list"
                   hx-include="[name='filter'],[name='sort']"
                   value="@Model.Search">
        </rhx-input>
    </div>
    <div class="toolbar__sort">
        <rhx-select rhx-label="Sort"
                    rhx-size="small"
                    name="sort"
                    hx-get="/?handler=TodoList"
                    hx-trigger="change"
                    hx-target="#todo-list"
                    hx-include="[name='filter'],[name='search']">
            <rhx-option value="created" selected="@(Model.Sort != "due" ? "selected" : null)">Newest first</rhx-option>
            <rhx-option value="due" selected="@(Model.Sort == "due" ? "selected" : null)">Due date</rhx-option>
        </rhx-select>
    </div>
    <div class="toolbar__actions">
        <rhx-button rhx-variant="brand"
                    data-rhx-dialog-open="add-todo-dialog">
            <rhx-icon name="plus" rhx-size="small"></rhx-icon>
            Add Task
        </rhx-button>
        @if (Model.CompletedCount > 0)
        {
            <rhx-tooltip rhx-content="Remove all completed tasks" rhx-placement="bottom">
                <rhx-button rhx-variant="danger"
                            rhx-appearance="outlined"
                            rhx-size="small"
                            hx-delete="/?handler=ClearCompleted"
                            hx-target="#todo-list"
                            hx-confirm="Remove all completed tasks?">
                    <rhx-icon name="trash" rhx-size="small"></rhx-icon>
                    Clear Done
                </rhx-button>
            </rhx-tooltip>
        }
    </div>
</div>

<!-- Filter Tabs -->
<rhx-tab-group aria-label="Task filters">
    <rhx-tab rhx-panel="tasks" rhx-active="@(Model.Filter != "active" && Model.Filter != "completed" && Model.Filter != "duesoon")"
             hx-get="/?handler=TodoList&filter=all"
             hx-target="#todo-list"
             hx-include="[name='sort']"
             hx-swap="innerHTML">
        All
        <rhx-badge rhx-variant="neutral" rhx-pill="true"><span id="badge-all">@Model.TotalCount</span></rhx-badge>
    </rhx-tab>
    <rhx-tab rhx-panel="tasks" rhx-active="@(Model.Filter == "active")"
             hx-get="/?handler=TodoList&filter=active"
             hx-target="#todo-list"
             hx-include="[name='sort']"
             hx-swap="innerHTML">
        Active
        <rhx-badge rhx-variant="brand" rhx-pill="true"><span id="badge-active">@Model.ActiveCount</span></rhx-badge>
    </rhx-tab>
    <rhx-tab rhx-panel="tasks" rhx-active="@(Model.Filter == "duesoon")"
             hx-get="/?handler=TodoList&filter=duesoon"
             hx-target="#todo-list"
             hx-include="[name='sort']"
             hx-swap="innerHTML">
        Due Soon
        <rhx-badge rhx-variant="warning" rhx-pill="true"><span id="badge-duesoon">@Model.DueSoonCount</span></rhx-badge>
    </rhx-tab>
    <rhx-tab rhx-panel="tasks" rhx-active="@(Model.Filter == "completed")"
             hx-get="/?handler=TodoList&filter=completed"
             hx-target="#todo-list"
             hx-include="[name='sort']"
             hx-swap="innerHTML">
        Completed
        <rhx-badge rhx-variant="success" rhx-pill="true"><span id="badge-completed">@Model.CompletedCount</span></rhx-badge>
    </rhx-tab>

    <rhx-tab-panel rhx-name="tasks" rhx-active="true">
        <div id="todo-list">
            @await Html.PartialAsync("_TodoList", Model.Todos)
        </div>
    </rhx-tab-panel>
</rhx-tab-group>

<input type="hidden" name="filter" value="@(Model.Filter ?? "all")" />

<!-- Add Task Dialog -->
<rhx-dialog id="add-todo-dialog" rhx-label="Add New Task">
    <form hx-post="/?handler=Add"
          hx-target="#todo-list"
          hx-swap="innerHTML"
          hx-include="[name='filter'],[name='sort']"
          class="dialog-form">
        <rhx-input rhx-label="Task title"
                   rhx-placeholder="What needs to be done?"
                   name="title"
                   required="required"
                   rhx-maxlength="200">
        </rhx-input>

        @await Html.PartialAsync("_TodoFields", (htmxRazor.Example.Models.TodoItem?)null)

        <rhx-dialog-footer>
            <rhx-button type="button"
                        rhx-appearance="outlined"
                        onclick="document.getElementById('add-todo-dialog').close()">
                Cancel
            </rhx-button>
            <rhx-button type="submit" rhx-variant="brand"
                        onclick="setTimeout(() => document.getElementById('add-todo-dialog').close(), 100)">
                <rhx-icon name="plus" rhx-size="small"></rhx-icon>
                Add Task
            </rhx-button>
        </rhx-dialog-footer>
    </form>
</rhx-dialog>

<!-- Edit Task Dialog — body is server-rendered (_EditForm) so the pickers bind their values -->
<rhx-dialog id="edit-todo-dialog" rhx-label="Edit Task">
    <div id="edit-form-body"></div>
</rhx-dialog>

<!-- Activity Log (v1.4: Timeline) -->
<rhx-divider />
<section class="activity-section">
    <div class="activity-section__header">
        <h2 class="activity-section__title">
            <rhx-icon rhx-name="clock" rhx-size="20" aria-hidden="true"></rhx-icon>
            Recent Activity
        </h2>
    </div>
    <div id="activity-log" hx-get="/?handler=ActivityLog" hx-trigger="todoChanged from:body" hx-swap="innerHTML">
        @await Html.PartialAsync("_ActivityLog", Model.Activities)
    </div>
</section>

@section Scripts {
<script>
    // Open the edit dialog once its server-rendered form (with bound pickers) has been swapped in.
    document.body.addEventListener('htmx:afterSwap', function(e) {
        if (e.detail.target && e.detail.target.id === 'edit-form-body') {
            document.getElementById('edit-todo-dialog').showModal();
        }
    });

    // Listen for todoChanged events to update filter tabs
    document.body.addEventListener('todoChanged', function() {
        // Update the hidden filter input based on current active tab
        var activeTab = document.querySelector('.rhx-tab[aria-selected="true"]');
        if (activeTab) {
            var panel = activeTab.getAttribute('aria-controls') || 'all';
            document.querySelector('[name="filter"]').value = panel;
        }
    });
</script>
}
